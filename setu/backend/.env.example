# Postgres connection string. Neon gives you one like postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setu
# Random long string used to sign JWT tokens. Anyone who has it can forge logins, so never commit the real one.
JWT_SECRET=replace-with-a-long-random-string
# How long a login stays valid, in minutes.
JWT_EXPIRE_MINUTES=720
# Comma-separated list of frontend origins allowed to call the API (add your Vercel URL after deploying).
CORS_ORIGINS=http://localhost:5173
# Public job feed used for market demand. Leave as is.
MARKET_API_URL=https://www.arbeitnow.com/api/job-board-api
